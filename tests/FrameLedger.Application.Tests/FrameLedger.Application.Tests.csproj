<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <RootNamespace>FrameLedger.Application.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FrameLedger.Application\FrameLedger.Application.csproj" />
    <!--
      CaptureSessionTests drive the session through the REAL consent adapter (SQLite, a scratch
      ledger per test) rather than a fake: GameConsentRecord.Stored is minted only by assemblies on
      Domain's InternalsVisibleTo list, and widening that list to a test project would be a second
      mint. Nothing else from Infrastructure is reached from here.
    -->
    <ProjectReference Include="..\..\src\FrameLedger.Infrastructure\FrameLedger.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
