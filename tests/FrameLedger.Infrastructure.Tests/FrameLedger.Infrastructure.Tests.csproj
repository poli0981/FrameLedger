<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <RootNamespace>FrameLedger.Infrastructure.Tests</RootNamespace>
    <!--
      ShmHandshakeValidatorTests builds FlShmHandshake fixtures, and buildId is a
      fixed buffer because a marshalled string would not be blittable
      (ShmLayoutMirrorTests asserts exactly that). Writing one needs unsafe.
    -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FrameLedger.Infrastructure\FrameLedger.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!--
    GuardMirrorTests and RulesPathAgreementTests P/Invoke into the real
    FrameLedger.Guard.dll, which NativeAntiCheatGuard loads by absolute path from
    AppContext.BaseDirectory — so it has to sit beside the test binary.
  -->
  <Import Project="$(MSBuildThisFileDirectory)..\..\FrameLedger.Guard.targets" />

  <!--
    The packaged seed, so the seeder tests run against the artifact that ships
    rather than against the repository path. One of them asserts the two are the
    same file.
  -->
  <Import Project="$(MSBuildThisFileDirectory)..\..\FrameLedger.Rules.targets" />

  <!--
    fl-layout-dump.exe, whose JSON is the native side of the struct-mirror
    assertion. ShmLayoutMirrorTests runs it rather than restating its numbers,
    because a second copy of the layout is what the mirror exists to catch.
  -->
  <Import Project="$(MSBuildThisFileDirectory)..\..\FrameLedger.LayoutDump.targets" />

  <!--
    The Overlay (payload) and hook-harness (target) for the drain integration test.
    The payload must sit in the guard's own directory or §S22 refuses the injection.
  -->
  <Import Project="$(MSBuildThisFileDirectory)..\..\FrameLedger.DrainFixtures.targets" />

</Project>
