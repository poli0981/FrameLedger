<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Capture orchestrator: process watcher, anti-cheat guard, injector control,
    shm drain, telemetry poller, session recorder (docs/04_CAPTURE.md).
    Runs as a standard user by default (ADR-9); elevation is optional and only
    unlocks CPU sensors, elevated-game attach, and the Tier-2 ETW source.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AssemblyName>FrameLedger.Agent</AssemblyName>
    <RootNamespace>FrameLedger.Agent</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FrameLedger.Application\FrameLedger.Application.csproj" />
    <ProjectReference Include="..\FrameLedger.Infrastructure\FrameLedger.Infrastructure.csproj" />
    <ProjectReference Include="..\FrameLedger.Shared\FrameLedger.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

  <!--
    The Agent is the SOLE host of the anti-cheat guard (§S18 blocker 3, ratified
    2026-08-04; 05_DETECTION §Trust and staleness and 07_IPC already assigned it
    ownership of %LOCALAPPDATA%\FrameLedger). FrameLedger.App deliberately does
    not import this.
  -->
  <Import Project="$(MSBuildThisFileDirectory)..\..\FrameLedger.Guard.targets" />

  <!-- The seed the Agent installs to the product location on first run (§S20). -->
  <Import Project="$(MSBuildThisFileDirectory)..\..\FrameLedger.Rules.targets" />

  <!--
    The payload, which must land in the SAME directory as the guard: §S22 makes
    the guard refuse a DLL that does not resolve there. Nothing shipped the
    Overlay anywhere before this import existed.
  -->
  <Import Project="$(MSBuildThisFileDirectory)..\..\FrameLedger.Overlay.targets" />

</Project>
