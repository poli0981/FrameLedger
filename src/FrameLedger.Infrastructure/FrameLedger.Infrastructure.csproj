<Project Sdk="Microsoft.NET.Sdk">

  <!--
    SQLite, shm reader, vendor telemetry, injector interop, ETW fallback,
    parsers. Implements the ports declared in FrameLedger.Application.

    CLAUDE.md: "The native layer is reachable only through Infrastructure —
    no P/Invoke anywhere else." This project is the only one that may carry
    CsWin32 or DllImport declarations.
  -->

  <ItemGroup>
    <ProjectReference Include="..\FrameLedger.Application\FrameLedger.Application.csproj" />
    <ProjectReference Include="..\FrameLedger.Shared\FrameLedger.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Dapper" />
    <PackageReference Include="LibreHardwareMonitorLib" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Microsoft.Windows.CsWin32">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
