<Project Sdk="Microsoft.NET.Sdk">

  <!--
    SQLite, shm reader, vendor telemetry, injector interop, ETW fallback,
    parsers. Implements the ports declared in FrameLedger.Application.

    CLAUDE.md: "The native layer is reachable only through Infrastructure —
    no P/Invoke anywhere else." This project is the only one that may carry
    CsWin32 or DllImport declarations.
  -->

  <ItemGroup>
    <ProjectReference Include="..\FrameLedger.Application\FrameLedger.Application.csproj" />
    <ProjectReference Include="..\FrameLedger.Shared\FrameLedger.Shared.csproj" />
  </ItemGroup>

  <!--
    The guard DLL is deliberately NOT copied from here any more (§S18 blocker 3,
    ratified 2026-08-04). A `None` item in this file flows to every project that
    references Infrastructure, which is how FrameLedger.exe came to host the
    anti-cheat guard as a side effect of wanting SQLite and detection — and why
    §S18 could not identify "our own process" by pid.

    The copy now lives in /FrameLedger.Guard.targets, imported only by the Agent
    (the host) and by Infrastructure.Tests (which P/Invokes the real DLL). This
    assembly still CALLS the guard through NativeAntiCheatGuard; it just no
    longer decides who ships it.
  -->

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Dapper" />
    <PackageReference Include="LibreHardwareMonitorLib" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Microsoft.Windows.CsWin32">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
